        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(llamacpp:requests_deferred{namespace=\"llm\"}) or vector(0)",
          "legendFormat": "",
