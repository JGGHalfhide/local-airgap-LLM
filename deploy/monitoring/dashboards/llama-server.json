      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(llamacpp:tokens_predicted_total{namespace=\"llm\"}[$__rate_interval])) / sum(rate(llamacpp:tokens_predicted_seconds_total{namespace=\"llm\"}[$__rate_interval]))",
          "legendFormat": "generation",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(llamacpp:prompt_tokens_total{namespace=\"llm\"}[$__rate_interval])) / sum(rate(llamacpp:prompt_seconds_total{namespace=\"llm\"}[$__rate_interval]))",
          "legendFormat": "prompt",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
