    {
      "id": 6,
      "type": "stat",
      "title": "Memory (working set)",
      "description": "Includes reclaimable page cache from reading the model; the process itself peaks at about 4.7 GiB at 32k context.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
